# Copy to .env at the repo root. The API validates every value at boot and
# refuses to start if anything is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the API listens on. The web dev server proxies /api to it.
API_PORT=4000

# Host port docker-compose publishes MongoDB on. Change it (and MONGODB_URI) if
# something else already uses 27017, such as a MongoDB Windows service.
MONGO_PORT=27017

# MongoDB connection string. Matches docker-compose.yml by default.
MONGODB_URI=mongodb://localhost:27017/samaj

# Secret for signing access tokens (JWT, HS256). At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Refresh tokens are random values stored hashed in MongoDB, so they need no secret.
JWT_ACCESS_SECRET=dev-only-access-secret-replace-before-deploying

# Access token lifetime in minutes (1-60). Kept short because it can't be revoked.
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in days (1-365). Each refresh rotates the token.
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# true when served over HTTPS, so cookies get the Secure flag. Must be true in production.
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (0 locally, usually 1 in production).
# Needed so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Requests per 15 minutes. Signed-in people are counted per account, because a
# mobile network puts thousands of phones behind one IP; anonymous traffic per IP.
# In production the counts live in MongoDB, so every API process shares them.
RATE_LIMIT_MAX=1000
ANON_RATE_LIMIT_MAX=300

# Sign-in, signup and password attempts per mobile number, and per IP, per 15 minutes.
AUTH_RATE_LIMIT_MAX=10
AUTH_IP_RATE_LIMIT_MAX=300

# Where photos are kept: disk (UPLOAD_DIR, one server only) or mongodb (GridFS,
# shared by every API server and included in database backups).
PHOTO_STORAGE=disk
# Relative to apps/api. Back this folder up.
UPLOAD_DIR=uploads

# MongoDB connections per API process.
DB_POOL_SIZE=20

# API processes to run on this machine; set to the number of CPU cores.
WEB_CONCURRENCY=1

# Who people contact about their personal data (shown in the privacy notice).
# Until set, the notice points people to their branch committee.
# PRIVACY_CONTACT_NAME=
# PRIVACY_CONTACT_EMAIL=
# PRIVACY_CONTACT_PHONE=
